<!DOCTYPE html>
<html lang="en" data-theme="region4">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Scouter" suffix=" · Phoenix Framework" phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
<header class="sticky top-0 z-50 bg-base-100/90 backdrop-blur-md border-b border-base-300">
  <div class="max-w-[1240px] mx-auto px-10 h-[68px] flex items-center justify-between gap-10">
    <.link navigate={~p"/"} class="flex items-baseline gap-2.5 text-base-content">
      <span class="w-2 h-2 bg-primary rounded-sm"></span>
      <span class="text-sm font-bold tracking-tight">Region 4 Scout</span>
      <span class="text-[11px] tracking-widest uppercase text-base-content/50">V5RC</span>
    </.link>
    <nav class="flex items-center gap-1">
      <.link navigate={~p"/"} class="px-3.5 py-2 text-sm text-base-content hover:opacity-70">Overview</.link>
      <.link navigate={~p"/events"} class="px-3.5 py-2 text-sm text-base-content hover:opacity-70">Events</.link>
      <%= if @current_user do %>
        <span class="px-3.5 py-2 text-sm text-base-content/70">{@current_user.email}</span>
        <.link href={~p"/auth/logout"} class="ml-3 btn btn-sm btn-primary rounded-full">Log out</.link>
      <% else %>
        <.link href={~p"/auth/google"} class="ml-3 btn btn-sm btn-primary rounded-full">Log in with Google</.link>
      <% end %>
    </nav>
  </div>
</header>
    {@inner_content}
  </body>
</html>
