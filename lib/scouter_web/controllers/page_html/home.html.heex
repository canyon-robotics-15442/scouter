<Layouts.flash_group flash={@flash} />
<main class="max-w-[1240px] mx-auto px-10">
  <section class="py-24 border-b border-base-300">
    <div class="text-[11px] tracking-widest uppercase text-primary mb-6">California — Region 4 · 2026–27 Season</div>
    <h1 class="text-7xl leading-[0.94] tracking-tighter font-bold text-balance">VEX V5 Scouter</h1>
    <p class="mt-7 max-w-[46ch] text-lg leading-relaxed text-base-content/70">Live event dates, attendance rosters, match history and world skills standings for every Region 4 team, pulled from the RobotEvents V5 API.</p>
    <div class="flex gap-3 mt-10">
      <.link navigate={~p"/events"} class="btn rounded-full bg-base-content text-base-100 border-0 px-6">Browse events</.link>
    </div>
  </section>
</main>